---
export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = "left",
  class: className = ""
} = Astro.props;
---

<div class={`section-heading ${align === "center" ? "text-center mx-auto" : ""} ${className}`}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 class="section-title">{title}</h2>
  {description && <p class="section-desc">{description}</p>}
</div>
