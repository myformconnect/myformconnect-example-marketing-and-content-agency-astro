---
import { siteConfig } from "../config/site";

export interface Props {
  class?: string;
  theme?: "light" | "dark";
}

const { class: className = "" } = Astro.props;
---

<div class={`social-links-wrapper ${className}`}>
  <!-- LinkedIn: authentic brand blue with white icon -->
  <a
    href={siteConfig.social.linkedin}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="WESTERVANE on LinkedIn"
    class="social-link social-link--linkedin"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 4c-1.144 0-2.063.926-2.063 2.065 0 1.138.92 2.063 2.063 2.063 1.14 0 2.064-.925 2.064-2.063 0-1.139-.925-2.065-2.064-2.065zm1.782 16.452H3.555V9h3.564v11.452z"></path>
    </svg>
  </a>

  <!-- Instagram: signature sunset gradient with white icon -->
  <a
    href={siteConfig.social.instagram}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="WESTERVANE on Instagram"
    class="social-link social-link--instagram"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
      <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"></circle>
    </svg>
  </a>
</div>

<style>
  .social-links-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm, 6px);
    color: #ffffff;
    text-decoration: none;
    transition: transform var(--transition-fast, 0.15s ease), filter var(--transition-fast, 0.15s ease);
  }

  .social-link:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }

  .social-link:active {
    transform: translateY(0);
  }

  /* LinkedIn official brand blue */
  .social-link--linkedin {
    background-color: #0a66c2;
  }

  /* Instagram signature sunset gradient */
  .social-link--instagram {
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
  }
</style>
