---
import { siteConfig } from "../config/site";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article" | "profile";
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = `${siteConfig.name} — London Digital Marketing & Content Agency`,
  description = siteConfig.description,
  canonical = Astro.url.href,
  image = "/favicon.svg",
  type = "website",
  jsonLd
} = Astro.props;

// Make sure the canonical and social preview image URLs are fully qualified
const canonicalUrl = new URL(canonical, siteConfig.url).href;
const imageUrl = image.startsWith("http") ? image : new URL(image, siteConfig.url).href;
const fullTitle = title.includes(siteConfig.name) ? title : `${title} | ${siteConfig.name}`;
---

<!-- Basic page title and description for search engines -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Social previews for LinkedIn, Facebook, and chat apps -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageUrl} />
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:locale" content="en_GB" />

<!-- Twitter / X preview card -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageUrl} />

<!-- Rich snippets and structured metadata for Google -->
{
  jsonLd && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd], null, 2)}
    />
  )
}
