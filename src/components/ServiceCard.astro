---
export interface Props {
  number: string;
  title: string;
  description: string;
  href?: string;
  class?: string;
}

const {
  number,
  title,
  description,
  href = "/services",
  class: className = ""
} = Astro.props;
---

<a href={href} class={`service-card ${className}`}>
  <div class="service-card-top">
    <span class="service-card-num">{number}</span>
    <span class="service-card-arrow" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 12L12 4M12 4H6M12 4V10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </div>
  <div class="service-card-body">
    <h3 class="service-card-title">{title}</h3>
    <p class="service-card-desc">{description}</p>
  </div>
</a>
