---
import BaseLayout from "./BaseLayout.astro";
import Button from "../components/Button.astro";
import { siteConfig } from "../config/site";

export interface Props {
  title: string;
  client: string;
  industry: string;
  services: string[];
  description: string;
  heroImage: string;
  metrics: Array<{ value: string; label: string }>;
  isConcept?: boolean;
}

const {
  title,
  client,
  industry,
  services,
  description,
  heroImage,
  metrics,
  isConcept = true
} = Astro.props;

const canonicalUrl = Astro.url.href;

// CreativeWork Schema
const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "name": `${client} Case Study — ${title}`,
  "headline": title,
  "description": description,
  "image": heroImage,
  "creator": {
    "@type": "Organization",
    "name": siteConfig.name
  },
  "about": {
    "@type": "Organization",
    "name": client
  },
  "genre": `${industry} Digital Marketing`
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteConfig.url
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Work",
      "item": `${siteConfig.url}/work`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": client,
      "item": canonicalUrl
    }
  ]
};
---

<BaseLayout
  title={`${client} — Case Study | ${siteConfig.name}`}
  description={description}
  canonical={canonicalUrl}
  image={heroImage}
  type="website"
  jsonLd={[caseStudySchema, breadcrumbSchema]}
>
  <article class="section-pad-sm">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumbs" style="margin-bottom: 2rem;">
        <ol style="display: flex; align-items: center; gap: 0.5rem; font-size: var(--text-xs); color: var(--color-muted);">
          <li><a href="/" style="color: var(--color-muted);">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/work" style="color: var(--color-muted);">Work</a></li>
          <li aria-hidden="true">/</li>
          <li style="color: var(--color-black); font-weight: 500;" aria-current="page">{client}</li>
        </ol>
      </nav>

      <!-- Case Study Hero Header -->
      <div style="max-width: 960px; margin-bottom: 3.5rem;">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem;">
          <span class="eyebrow eyebrow-accent" style="margin-bottom: 0;">{industry}</span>
          {
            isConcept && (
              <span class="london-badge" style="background-color: var(--color-surface-subtle);">
                Concept project — created for demonstration
              </span>
            )
          }
        </div>

        <h1 style="font-size: var(--text-5xl); font-weight: 500; line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 1.5rem;">
          {title}
        </h1>

        <p class="text-lead" style="max-width: 58ch; margin-bottom: 2.5rem;">
          {description}
        </p>

        <!-- Project Meta Strip -->
        <div class="grid-3 surface-card" style="padding: 1.5rem 2rem;">
          <div>
            <span class="eyebrow" style="margin-bottom: 0.25rem;">Client</span>
            <p style="font-weight: 500; font-size: var(--text-base); color: var(--color-black);">{client}</p>
          </div>
          <div>
            <span class="eyebrow" style="margin-bottom: 0.25rem;">Industry</span>
            <p style="font-weight: 500; font-size: var(--text-base); color: var(--color-black);">{industry}</p>
          </div>
          <div>
            <span class="eyebrow" style="margin-bottom: 0.25rem;">Disciplines</span>
            <p style="font-weight: 500; font-size: var(--text-base); color: var(--color-black);">{services.join(", ")}</p>
          </div>
        </div>
      </div>

      <!-- Hero Visual -->
      <div style="border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--color-border); margin-bottom: 4rem; aspect-ratio: 16 / 9; box-shadow: var(--shadow-card);">
        <img
          src={heroImage}
          alt={`${client} case study hero preview`}
          width="1280"
          height="720"
          style="width: 100%; height: 100%; object-fit: cover;"
        />
      </div>

      <!-- Performance Metrics Banner -->
      {
        metrics && metrics.length > 0 && (
          <div style="margin-bottom: 5rem; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 3rem 0;">
            <div class="grid-3 text-center">
              {metrics.map((m) => (
                <div>
                  <div style="font-size: var(--text-4xl); font-weight: 500; color: var(--color-black); letter-spacing: -0.03em; margin-bottom: 0.5rem;">
                    {m.value}
                  </div>
                  <div style="font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-muted);">
                    {m.label}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )
      }

      <!-- Case Study Body Prose -->
      <div class="container-narrow">
        <section class="prose-editorial">
          <slot />
        </section>

        <!-- Project CTA / Next Steps -->
        <div class="surface-card" style="margin-top: 5rem; text-align: center; padding: clamp(2.5rem, 5vw, 4rem);">
          <span class="eyebrow eyebrow-accent">Next Project</span>
          <h2 style="font-size: var(--text-3xl); font-weight: 500; margin-bottom: 1rem;">
            Ready to build your growth engine?
          </h2>
          <p style="font-size: var(--text-base); color: var(--color-muted); max-width: 48ch; margin: 0 auto 2rem;">
            Let's discuss how our strategic methodology can accelerate organic acquisition and elevate your brand presence.
          </p>
          <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
            <Button href="/contact" variant="primary" arrow>
              Start a conversation
            </Button>
            <Button href="/work" variant="outline">
              View all case studies
            </Button>
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
