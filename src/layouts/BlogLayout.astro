---
import BaseLayout from "./BaseLayout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import Button from "../components/Button.astro";
import { siteConfig } from "../config/site";

export interface Props {
  title: string;
  description: string;
  publishDate: string;
  updatedDate?: string;
  author: string;
  category: string;
  tags: string[];
  image: string;
  readingTime: string;
}

const {
  title,
  description,
  publishDate,
  updatedDate,
  author,
  category,
  tags,
  image,
  readingTime
} = Astro.props;

const canonicalUrl = Astro.url.href;

const formattedPublishDate = new Date(publishDate).toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric"
});

const formattedUpdatedDate = updatedDate
  ? new Date(updatedDate).toLocaleDateString("en-GB", {
      day: "numeric",
      month: "long",
      year: "numeric"
    })
  : null;

// Article Schema
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "image": image,
  "author": {
    "@type": "Person",
    "name": author
  },
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.name,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteConfig.url}/favicon.svg`
    }
  },
  "datePublished": publishDate,
  "dateModified": updatedDate || publishDate,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "keywords": tags.join(", ")
};

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteConfig.url
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Insights",
      "item": `${siteConfig.url}/blog`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": title,
      "item": canonicalUrl
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  image={image}
  type="article"
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <div class="container-narrow section-pad-sm">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="Breadcrumbs" style="margin-bottom: 2rem;">
      <ol style="display: flex; align-items: center; gap: 0.5rem; font-size: var(--text-xs); color: var(--color-muted);">
        <li><a href="/" style="color: var(--color-muted);">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/blog" style="color: var(--color-muted);">Insights</a></li>
        <li aria-hidden="true">/</li>
        <li style="color: var(--color-black); font-weight: 500;" aria-current="page">{category}</li>
      </ol>
    </nav>

    <article>
      <!-- Article Header -->
      <header style="margin-bottom: 2.5rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1rem;">
          <span class="eyebrow eyebrow-accent" style="margin-bottom: 0;">{category}</span>
          <span style="color: var(--color-border);">•</span>
          <span style="font-size: var(--text-xs); color: var(--color-muted);">{readingTime}</span>
        </div>

        <h1 style="font-size: var(--text-4xl); font-weight: 500; line-height: 1.15; letter-spacing: -0.03em; margin-bottom: 1.5rem;">
          {title}
        </h1>

        <p class="text-lead" style="margin-bottom: 2rem;">
          {description}
        </p>

        <div style="display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 1rem 0; font-size: var(--text-xs); color: var(--color-muted);">
          <div>
            <span>By </span>
            <strong style="color: var(--color-black); font-weight: 600;">{author}</strong>
          </div>
          <div>
            <span>Published </span>
            <time datetime={publishDate}>{formattedPublishDate}</time>
            {
              formattedUpdatedDate && (
                <span> (Updated <time datetime={updatedDate}>{formattedUpdatedDate}</time>)</span>
              )
            }
          </div>
        </div>
      </header>

      <!-- Featured Image Container -->
      <div style="margin-bottom: 3rem; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--color-border); aspect-ratio: 16 / 9;">
        <img
          src={image}
          alt={title}
          width="840"
          height="472"
          style="width: 100%; height: 100%; object-fit: cover;"
        />
      </div>

      <!-- Article Prose Body -->
      <section class="prose-editorial">
        <slot />
      </section>

      <!-- Article Tags -->
      <footer style="margin-top: 3.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border);">
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center;">
          <span style="font-size: var(--text-xs); font-weight: 600; text-transform: uppercase; color: var(--color-muted); margin-right: 0.5rem;">Tags:</span>
          {
            tags.map((tag) => (
              <span style="font-size: var(--text-xs); background: var(--color-surface); border: 1px solid var(--color-border); padding: 0.25rem 0.6rem; border-radius: var(--radius-sm);">
                {tag}
              </span>
            ))
          }
        </div>
      </footer>
    </article>

    <!-- Post Article Conversion / Newsletter Strip -->
    <div class="surface-card" style="margin-top: 4rem; text-align: center;">
      <span class="eyebrow eyebrow-accent">The London Dispatch</span>
      <h3 style="font-size: var(--text-2xl); font-weight: 500; margin-bottom: 0.75rem;">
        Enjoyed this perspective?
      </h3>
      <p style="font-size: var(--text-sm); color: var(--color-muted); max-width: 44ch; margin: 0 auto 1.5rem;">
        Get actionable marketing strategies, organic search breakdowns, and editorial thinking delivered fortnightly.
      </p>
      <div style="display: flex; justify-content: center;">
        <NewsletterForm id="article-bottom-newsletter" buttonText="Subscribe" />
      </div>
    </div>

    <!-- Back to Insights -->
    <div style="margin-top: 3rem; text-align: center;">
      <Button href="/blog" variant="outline" arrow>
        Back to all insights
      </Button>
    </div>
  </div>
</BaseLayout>
